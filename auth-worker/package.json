{
    "name": "auth-worker",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "typecheck": "tsc -p tsconfig.json",
        "test": "node --experimental-strip-types --test test/translate.test.ts tests/*.test.mjs",
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "migration:local": "wrangler d1 execute auth-db --local --file",
        "migration:remote": "wrangler d1 execute auth-db --remote --file"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261016.1",
        "typescript": "^7.0.2",
        "wrangler": "^4.151.0"
    }
}
