<?xml version="1.0" encoding="utf-8"?>
<!--
  loverpreview 构建类型专用清单：与 eggpreview 那份同构（点图标直接进彩蛋、桌面上只留一个图标），
  只换了 activity 的包名与标签。

  Application 仍是 main 里那份 @HiltAndroidApp 的 TraktSearchApp（清单合并保留）：
  MainActivity（@AndroidEntryPoint）在本变体里仍然声明着，换成裸 Application 会让它一旦
  被拉起就崩，给一个调试包留这种暗坑不值得。预览页自己一个注入点都不碰。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 连 application 的名字一起换掉：设备上同时装着 eggpreview 与 loverpreview 两份预览包，
         三份「霉粉彩蛋预览」并排放在应用列表里必然卸错 -->
    <application
        android:label="@string/lover_preview_label"
        tools:replace="android:label">

        <!--
          不显式给 android:theme，继承 application 的 Theme.TraktoSearch
          （AppCompat.DayNight.NoActionBar + 透明系统栏），正好是全屏彩蛋要的形状。
          不能跟着 MainActivity 用 Theme.App.Starting —— 那是启动页主题，
          预览包不该在每次截图前先放一遍场记板。
        -->
        <activity
            android:name="com.tracktosearch.loverpreview.SwiftieEggPreviewActivity"
            android:exported="true"
            android:label="@string/lover_preview_label"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          抹掉 MainActivity 的全部 intent-filter：需求是「点图标直接进彩蛋」，
          两个图标每次都要挑一下。用 removeAll 而不是 remove，理由见 eggpreview 那份清单 ——
          按 key 精确匹配要手抄整段 filter，抄出分叉会静默失配。

          代价是 Trakt OAuth 回调那条 VIEW filter 也一起没了：本变体不登录、不走授权流程。
        -->
        <activity android:name="com.tracktosearch.MainActivity">
            <intent-filter tools:node="removeAll" />
        </activity>
    </application>
</manifest>
