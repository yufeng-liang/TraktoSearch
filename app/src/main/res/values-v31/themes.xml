<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) SplashScreen API
         让系统默认启动页就是蓝色渐变背景 + 居中图标，
         避免出现"先白屏/原图标 → 再切到自定义渐变"的两次启动页。 -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 渐变背景（系统启动页会使用这张图） -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- 启动页中央的图标（系统自动着色为 windowSplashScreenIconBackgroundColor） -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <!-- 启动完成后立即切换到的主题 -->
        <item name="postSplashScreenTheme">@style/Theme.TraktToSearch</item>
    </style>
</resources>
