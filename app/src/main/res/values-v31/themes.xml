<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) SplashScreen API
         让系统默认启动页就是暖纸背景 + 居中图标，
         避免出现"先白屏/原图标 → 再切到自绘 splash"的两次启动页。 -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 走 @color/splash_background 而不是写死 hex：深色档由 values-night/colors.xml 覆盖，
             否则深色模式冷启动会先闪一屏浅奶油再切进深色 App。 -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- 使用透明 1dp drawable 隐藏系统 splash 图标 -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_clapper_animated</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding_image</item>
        <!-- 动画时长 -->
        <item name="windowSplashScreenAnimationDuration">720</item>
        <!-- 启动完成后立即切换到的主题 -->
        <item name="postSplashScreenTheme">@style/Theme.TraktoSearch</item>
    </style>
    <!-- 开屏日签开着的场合走这一档：静态图标、不写动画时长。
         日签数据一就绪系统 splash 立刻散场（等的是 stampReady，见 MainActivity），
         合板动画那时候通常没演完——半截动画像卡住，而那段等待本来就该交给日签。
         背景与品牌条两档共用，差别只有图标这一处。 -->
    <style name="Theme.App.Starting.SplashQuote">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_clapper</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding_image</item>
        <item name="postSplashScreenTheme">@style/Theme.TraktoSearch</item>
    </style>
</resources>
