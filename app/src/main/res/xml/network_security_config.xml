<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：
  1. 允许明文流量（cleartextTrafficPermitted=true）：BYOK AI 允许用户自填 http:// 服务地址
     （本地 Ollama / 内网中转等）。第一方端点（网关/TMDB/豆瓣）仍全部 https，此开关只是解除
     平台对用户自配地址的拦截；AI 配置页对 http 地址显示明文传输安全提示。
  2. 仅信任系统 CA，不信任用户安装的 CA，防止中间人攻击（用户安装的根证书可能是恶意软件注入）
  3. 豆瓣域名特殊处理：保留对系统 CA 的信任，因为 doubanio.com 图片 CDN 必须可访问
  4. 不实施 CertificatePinner：Cloudflare Workers/Pages 边缘证书由 CF 管理，~90 天轮换，
     SPKI 可能变化，pinning 会导致证书轮换后 App 无法访问网关，风险大于收益
-->
<network-security-config>
    <!-- 基础配置：仅信任系统 CA（明文流量见头部注释 1） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
