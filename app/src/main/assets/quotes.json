        "zh": "卡萨布兰卡",
        "ja": "カサブランカ",
        "ko": "카사블랑카"
      }
    },
    {
      "id": "shawshank",
      "year": 1994,
      "tmdbId": 278,
      "posterPath": "/9cqNxx0GxF0bflZmeSMuL5tnGzr.jpg",
      "bundled": true,
      "lines": {
        "en": ["Hope is a good thing,", "maybe the best of things.", "And no good thing ever dies."],
        "zh": ["希望是好东西，", "也许是世上最好的东西。", "好东西从来不会消失。"],
        "ja": ["希望はいいものだ。", "たぶん最高のものだ。", "いいものは", "決して滅びない。"],
        "ko": ["희망은 좋은 것이고,", "어쩌면 최고의 것이다.", "좋은 것은 결코", "사라지지 않는다."]
      },
      "title": {
        "en": "The Shawshank Redemption",
        "zh": "肖申克的救赎",
        "ja": "ショーシャンクの空に",
        "ko": "쇼생크 탈출"
      }
    },
    {
      "id": "farewell-my-concubine",
      "year": 1993,
      "tmdbId": 10997,
      "posterPath": "/f54hNIiHNINw3JiUJB2XaQl5wCN.jpg",
      "bundled": true,
      "lines": {
        "en": ["We agreed on a lifetime.", "A year less, a month, a day,", "even an hour —", "that is not a lifetime."],
        "zh": ["说好了是一辈子。", "差一年，一个月，一天，", "一个时辰，都不算一辈子。"],
        "ja": ["一生と約束した。", "一年、一月、一日、", "一刻でも足りなければ、", "一生とは言えない。"],
        "ko": ["평생을 약속했잖아.", "한 해, 한 달, 하루,", "한 시라도 모자라면", "평생이 아니야."]
      },
      "title": {
        "en": "Farewell My Concubine",
        "zh": "霸王别姬",
        "ja": "さらば、わが愛／覇王別姫",
        "ko": "패왕별희"
      }
    },
    {
      "id": "blade-runner",
      "year": 1982,
      "tmdbId": 78,
      "posterPath": "/63N9uy8nd9j7Eog2axPQ8lbr3Wj.jpg",
      "bundled": true,
      "lines": {
        "en": ["All those moments", "will be lost in time,", "like tears in rain."],
        "zh": ["所有这些瞬间", "都将消失在时光中，", "一如雨中的泪水。"],
        "ja": ["そういう思い出もすべて、", "時の中に消える。", "雨の中の涙のように。"],
        "ko": ["그 모든 순간들은", "시간 속에 사라지겠지.", "빗속의 눈물처럼."]
      },
      "title": {
        "en": "Blade Runner",
        "zh": "银翼杀手",
        "ja": "ブレードランナー",
        "ko": "블레이드 러너"
      }
    },
    {
      "id": "chungking-express",
      "year": 1994,
      "tmdbId": 11104,
      "posterPath": "/43I9DcNoCzpyzK8JCkJYpHqHqGG.jpg",
      "bundled": true,
      "lines": {
        "en": ["If memories could be canned,", "I hope this one never expires."],
        "zh": ["如果记忆是一个罐头的话，", "我希望这罐罐头", "永远不会过期。"],
        "ja": ["記憶が缶詰なら、", "この缶だけは", "賞味期限が", "来ないでほしい。"],
        "ko": ["기억이 통조림이라면,", "이 통조림만은", "유통기한이 없기를."]
      },
      "title": {
        "en": "Chungking Express",
        "zh": "重庆森林",
        "ja": "恋する惑星",
        "ko": "중경삼림"
      }
    },
    {
